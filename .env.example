# APilot environment variables (names only — no secrets, all optional).

# The deterministic AP decision core needs NO environment variables.
# The variables below are read ONLY by the optional LLM invoice-extraction
# feature (POST /api/extract, see apilot/extract.py).

# API key for the OpenAI-compatible extraction model.
# Unset => extraction returns "APILOT_LLM_KEY is not set"; core demo unaffected.
APILOT_LLM_KEY=

# OpenAI-compatible chat-completions base URL (default: https://api.openai.com/v1).
APILOT_LLM_BASE_URL=

# Model name (default: gpt-4o-mini).
APILOT_LLM_MODEL=
